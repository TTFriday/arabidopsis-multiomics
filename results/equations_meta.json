{
  "display": {
    "1": {
      "desc": "Benjamini-Hochberg adjustment",
      "latex": "$q_i \\;=\\; \\min\\,\\{\\, m \\cdot P_j / j \\;:\\; 1 \\leq i \\leq j \\leq m \\,\\}$",
      "png": "eq_display_1.png",
      "width_in": 3.175,
      "height_in": 0.2483
    },
    "2": {
      "desc": "gene coordinate from intragenic SNPs",
      "latex": "$\\mathrm{pos}(g) \\;=\\; \\mathrm{median}\\,\\{\\, x_s \\;:\\; s \\in S(g) \\,\\}$",
      "png": "eq_display_2.png",
      "width_in": 2.8883,
      "height_in": 0.24
    },
    "3": {
      "desc": "per-chromosome calibration of gene position",
      "latex": "$\\mathrm{cpos}(g) \\;=\\; a^{c} \\,+\\, b^{c}\\,\\mathrm{num}(g)$",
      "png": "eq_display_3.png",
      "width_in": 2.2767,
      "height_in": 0.1977
    },
    "4": {
      "desc": "matched-null overlap and its expectation",
      "latex": "$O = |A \\cap B| \\,;\\qquad E[O] \\;=\\; \\frac{1}{N}\\sum_{k}\\left|A_{(k)} \\cap B\\right|$",
      "png": "eq_display_4.png",
      "width_in": 3.4317,
      "height_in": 0.4067
    },
    "5": {
      "desc": "standardised excess over the matched null",
      "latex": "$z \\;=\\; \\dfrac{O - E[O]}{\\mathrm{sd}(O)}$",
      "png": "eq_display_5.png",
      "width_in": 1.2283,
      "height_in": 0.4767
    },
    "6": {
      "desc": "Jaccard index of two feature sets",
      "latex": "$J(A,B) \\;=\\; \\dfrac{|A \\cap B|}{|A \\cup B|}$",
      "png": "eq_display_6.png",
      "width_in": 1.615,
      "height_in": 0.4767
    },
    "7": {
      "desc": "odds ratio for 2x2 enrichment tables",
      "latex": "$\\mathrm{OR} \\;=\\; \\dfrac{n_{11}\\,n_{00}}{n_{10}\\,n_{01}}$",
      "png": "eq_display_7.png",
      "width_in": 1.2167,
      "height_in": 0.385
    },
    "8": {
      "desc": "partial Spearman correlation",
      "latex": "$r_{XY\\cdot Z} \\;=\\; \\mathrm{cor}\\left(\\, \\tilde{r}_X,\\; \\tilde{r}_Y \\,\\right)$",
